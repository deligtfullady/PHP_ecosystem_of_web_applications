# Установка:
#   sudo cp deploy/systemd/worker.service /etc/systemd/system/reminder-worker.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now reminder-worker
#   systemctl status reminder-worker      journalctl -u reminder-worker -f
# Путь к проекту и пользователя замените на свои.

[Unit]
Description=Reminder bot: worker (отправка напоминаний по расписанию)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/telegram-reminder-bot
ExecStart=/usr/bin/php8.2 /var/www/telegram-reminder-bot/runner -c worker
# systemctl reload → SIGHUP: демон дорабатывает текущую минуту, сохраняет позицию и выходит,
# а Restart=always сразу поднимает его заново
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
