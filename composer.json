{
    "name": "student/telegram-reminder-bot",
    "description": "Бот-напоминалка: консольный PHP, демон, Telegram API, Redis-кэш, очередь RabbitMQ",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-pcntl": "*",
        "predis/predis": "^2.2",
        "psr/simple-cache": "^3.0",
        "php-amqplib/php-amqplib": "^3.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "infection/infection": "^0.27"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "allow-plugins": { "infection/extension-installer": true }
    }
}
