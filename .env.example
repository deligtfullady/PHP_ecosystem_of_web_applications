# Скопируйте в .env и заполните
TELEGRAM_TOKEN=123456:replace-with-token-from-BotFather
TIMEZONE=Europe/Moscow
DB_PATH=storage/events.sqlite

# Redis (кэш offset и истории сообщений Telegram)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# RabbitMQ (очередь отправки сообщений)
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
